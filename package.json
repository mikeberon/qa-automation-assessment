{
  "name": "qa-automation-assessment",
  "type": "module",
  "devDependencies": {
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.2.0",
    "@wdio/allure-reporter": "^9.30.1",
    "@wdio/cli": "^9.30.1",
    "@wdio/globals": "^9.29.1",
    "@wdio/local-runner": "^9.30.1",
    "@wdio/mocha-framework": "^9.30.1",
    "@wdio/spec-reporter": "^9.30.1",
    "allure-commandline": "^2.43.0",
    "chai": "^6.2.2",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "axios": "^1.19.0"
  },
  "scripts": {
    "test": "wdio run wdio.conf.ts",
    "test:ui": "wdio run wdio.conf.ts --spec ./test/ui/**/*.spec.ts",
    "test:home": "wdio run wdio.conf.ts --spec ./test/ui/specs/home.spec.ts",
    "test:flight-search": "wdio run wdio.conf.ts --spec ./test/ui/specs/flight-search.spec.ts",
    "test:api": "wdio run wdio.conf.ts --spec ./test/api/**/*.spec.ts",
    "typecheck": "tsc --noEmit",
    "report:generate": "allure generate allure-results --clean -o allure-report",
    "report:open": "allure open allure-report",
    "report": "npm run report:generate && npm run report:open"
  }
}